<%- include('../partials/auth-header') %>

<h1 class="auth-title">Registrasi</h1>
<p class="auth-sub">Daftarkan akun mahasiswa atau dosen baru.</p>

<% if (errors && errors.length) { %>
  <div class="alert alert-error">
    <ul class="error-list">
      <% errors.forEach(e => { %><li><%= e %></li><% }) %>
    </ul>
  </div>
<% } %>

<form method="POST" action="/register" class="form" novalidate>
  <div class="field">
    <label for="name">Nama Lengkap</label>
    <input type="text" id="name" name="name" required value="<%= body && body.name ? body.name : '' %>">
  </div>
  <div class="field">
    <label for="email">Email</label>
    <input type="email" id="email" name="email" required placeholder="nama@kampus.ac.id"
           value="<%= body && body.email ? body.email : '' %>">
  </div>
  <div class="field">
    <label for="phone">No. Telepon <span class="muted">(opsional)</span></label>
    <input type="tel" id="phone" name="phone" value="<%= body && body.phone ? body.phone : '' %>">
  </div>
  <div class="field">
    <label for="role">Saya adalah</label>
    <select id="role" name="role" required>
      <option value="mahasiswa" <%= body && body.role === 'mahasiswa' ? 'selected' : '' %>>Mahasiswa</option>
      <option value="dosen" <%= body && body.role === 'dosen' ? 'selected' : '' %>>Dosen</option>
    </select>
  </div>
  <div class="field-row">
    <div class="field">
      <label for="password">Password</label>
      <input type="password" id="password" name="password" required minlength="6">
    </div>
    <div class="field">
      <label for="confirm">Ulangi Password</label>
      <input type="password" id="confirm" name="confirm" required minlength="6">
    </div>
  </div>
  <button type="submit" class="btn btn-primary btn-block">Daftar</button>
</form>

<p class="auth-switch">Sudah punya akun? <a href="/login">Login di sini</a></p>

<%- include('../partials/auth-footer') %>
