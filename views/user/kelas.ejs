<%- include('../partials/header') %>

<div class="page-head">
  <div>
    <h1>Daftar Kelas</h1>
    <p class="muted">Pilih kelas untuk melihat detail dan jadwal penggunaannya.</p>
  </div>
</div>

<form method="GET" action="/kelas" class="filter-bar">
  <div class="field">
    <label for="q">Pencarian</label>
    <input type="text" id="q" name="q" placeholder="Nama ruangan / gedung" value="<%= filters.q %>">
  </div>
  <div class="field">
    <label for="building">Gedung</label>
    <select id="building" name="building">
      <option value="">Semua gedung</option>
      <% buildings.forEach(bg => { %>
        <option value="<%= bg %>" <%= filters.building === bg ? 'selected' : '' %>><%= bg %></option>
      <% }) %>
    </select>
  </div>
  <div class="field">
    <label for="min_capacity">Kapasitas minimal</label>
    <input type="number" id="min_capacity" name="min_capacity" min="1" placeholder="cth. 40" value="<%= filters.min_capacity %>">
  </div>
  <div class="field">
    <label for="facility">Fasilitas</label>
    <select id="facility" name="facility">
      <option value="">Semua fasilitas</option>
      <% facilityOptions.forEach(f => { %>
        <option value="<%= f %>" <%= filters.facility === f ? 'selected' : '' %>><%= f %></option>
      <% }) %>
    </select>
  </div>
  <div class="field">
    <label for="status">Status</label>
    <select id="status" name="status">
      <option value="">Semua status</option>
      <option value="Tersedia" <%= filters.status === 'Tersedia' ? 'selected' : '' %>>Tersedia</option>
      <option value="Tidak tersedia" <%= filters.status === 'Tidak tersedia' ? 'selected' : '' %>>Tidak tersedia</option>
    </select>
  </div>
  <div class="field filter-actions">
    <button type="submit" class="btn btn-primary">Terapkan</button>
    <a class="btn btn-ghost" href="/kelas">Reset</a>
  </div>
</form>

<% if (classrooms.length === 0) { %>
  <div class="card"><p class="empty">Tidak ada kelas yang cocok dengan filter.</p></div>
<% } else { %>
  <div class="card-grid">
    <% classrooms.forEach(c => { %>
      <article class="card room-card">
        <div class="room-card-head">
          <h3><%= c.room_name %></h3>
          <span class="badge <%= c.status === 'Tersedia' ? 'badge-approved' : 'badge-rejected' %>"><%= c.status %></span>
        </div>
        <ul class="room-meta">
          <li><span>Gedung</span><strong><%= c.building %></strong></li>
          <li><span>Lantai</span><strong><%= c.floor %></strong></li>
          <li><span>Kapasitas</span><strong><%= c.capacity %> orang</strong></li>
        </ul>
        <div class="chip-row">
          <% facs(c.facilities).forEach(f => { %><span class="chip"><%= f %></span><% }) %>
        </div>
        <div class="room-actions">
          <a class="btn btn-primary btn-sm" href="/kelas/<%= c.id %>">Lihat Detail</a>
        </div>
      </article>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/footer') %>
