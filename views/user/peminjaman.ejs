<%- include('../partials/header') %>

<div class="page-head">
  <div>
    <h1>Peminjaman Saya</h1>
    <p class="muted">Riwayat dan status seluruh peminjaman Anda.</p>
  </div>
  <a class="btn btn-primary" href="/peminjaman/baru">+ Ajukan Peminjaman</a>
</div>

<div class="filter-links">
  <a class="chip-link <%= filter === '' ? 'active' : '' %>" href="/peminjaman">Semua</a>
  <% ['Menunggu', 'Disetujui', 'Ditolak', 'Selesai', 'Dibatalkan'].forEach(s => { %>
    <a class="chip-link <%= filter === s ? 'active' : '' %>" href="/peminjaman?status=<%= s %>"><%= s %></a>
  <% }) %>
</div>

<section class="card">
  <% if (bookings.length === 0) { %>
    <p class="empty">
      <%= filter ? 'Tidak ada peminjaman berstatus "' + filter + '.' : 'Anda belum memiliki peminjaman.' %>
      <a href="/peminjaman/baru">Ajukan sekarang</a>
    </p>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>#</th><th>Kelas</th><th>Tanggal</th><th>Waktu</th><th>Keperluan</th>
            <th>Status</th><th>Catatan Admin</th><th>Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% bookings.forEach(b => { %>
            <tr>
              <td><%= b.id %></td>
              <td><strong><%= b.room_name %></strong><br><span class="muted"><%= b.building %></span></td>
              <td><%= fmtDate(b.booking_date) %></td>
              <td><%= fmtTime(b.start_time) %>–<%= fmtTime(b.end_time) %></td>
              <td><%= b.purpose %></td>
              <td><span class="badge <%= badgeClass(b.status) %>"><%= b.status %></span></td>
              <td class="note-cell"><%= b.admin_note ? b.admin_note : '—' %></td>
              <td class="actions-cell">
                <a class="btn btn-ghost btn-sm" href="/peminjaman/<%= b.id %>">Detail</a>
                <% if (b.status === 'Menunggu') { %>
                  <form method="POST" action="/peminjaman/<%= b.id %>/batal" class="inline-form"
                        data-confirm="Batalkan pengajuan peminjaman #<%= b.id %>?">
                    <button type="submit" class="btn btn-danger btn-sm">Batalkan</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>
